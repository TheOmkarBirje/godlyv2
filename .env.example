# =============================================================================
# Local quick start (no Cloudflare): cp .env.example .env OR use repo .env template
#   pnpm install && pnpm dev:local
#   CMS admin → http://localhost:3000/admin
#   Web       → http://localhost:4321
#   MONGODB_URI=mongodb://127.0.0.1:27017/godly (via docker compose)
# =============================================================================

# =============================================================================
# Godly.Design — TEST environment (copy to .env)
# Domains:
#   test.godly.design            → Astro web (Cloudflare Pages)
#   teststorage.godly.design     → R2 public CDN
#   testcms.godly.design         → Payload CMS
#   testapi.godly.design         → MCP Worker
# =============================================================================

# --- Environment label ---
GODLY_ENV=test

# --- Astro web (Cloudflare Pages SSR) ---
PAYLOAD_CMS_URL=https://testcms.godly.design
SITE_URL=https://test.godly.design

# --- Payload CMS ---
PAYLOAD_SECRET=change-me-before-test-deploy
# Required for CMS + MCP worker → CMS requests

# --- MongoDB (PayloadCMS + MCP vector search) ---
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/godly-design-test

# --- Cloudflare R2 (media CDN at teststorage.godly.design) ---
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=godly-design-test
R2_PUBLIC_DOMAIN=https://teststorage.godly.design

# --- Internal secrets (mcpSecrets API access, admin hooks) ---
INTERNAL_MCP_SECRET=
INTERNAL_ADMIN_SECRET=

# --- MCP Worker → Payload CMS ---
GODLY_CHECKOUT_URL=https://test.godly.design/pricing
MCP_ALLOWED_ORIGINS=https://test.godly.design,http://localhost:4321
# Optional local dev only (never in production Worker):
# GODLY_DEV_API_KEY=local-test-key

# --- Cloudflare KV (MCP rate limits + API key registry) ---
CLOUDFLARE_KV_NAMESPACE_ID=

# --- Gemini (ingestion: design tokens & embeddings) ---
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Clerk (developer auth & API keys) ---
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
