{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@godly/web/*": ["./apps/web/src/*"],
      "@godly/cms/*": ["./apps/cms/src/*"],
      "@godly/mcp-server/*": ["./apps/mcp-server/src/*"],
      "@godly/scripts/*": ["./packages/scripts/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", ".astro", ".wrangler"]
}
