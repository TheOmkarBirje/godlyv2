{
  "name": "godly-design",
  "version": "0.0.0",
  "private": true,
  "description": "Godly.Design — visual inspiration platform and monetized MCP component registry",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r --parallel run dev",
    "docker:up": "docker compose up -d --wait",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f mongo",
    "dev:local": "pnpm docker:up && pnpm --parallel --filter @godly/cms --filter @godly/web run dev",
    "dev:local:all": "pnpm docker:up && pnpm --parallel --filter @godly/cms --filter @godly/web --filter @godly/mcp-server run dev",
    "dev:web": "pnpm --filter @godly/web dev",
    "dev:cms": "pnpm --filter @godly/cms dev",
    "dev:mcp": "pnpm --filter @godly/mcp-server dev",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "clean": "pnpm -r run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
